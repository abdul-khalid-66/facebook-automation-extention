{
  "manifest_version": 3,
  "name": "Skoolyst FB Groups Poster",
  "version": "7.2.0",
  "description": "Post text/image posts and MCQ polls to Facebook Groups with smart daily rotation & scheduling",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icons/icon48.png"
  }
}
